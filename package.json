{
	"name": "promise.allsettledkeyed",
	"version": "0.0.0",
	"author": "Jordan Harband <ljharb@gmail.com>",
	"funding": {
		"url": "https://github.com/sponsors/ljharb"
	},
	"contributors": [
		{
			"name": "Jordan Harband",
			"email": "ljharb@gmail.com",
			"url": "http://ljharb.codes"
		}
	],
	"description": "ES Proposal spec-compliant shim for Promise.allSettledKeyed",
	"license": "MIT",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./auto": "./auto.js",
		"./polyfill": "./polyfill.js",
		"./implementation": "./implementation.js",
		"./shim": "./shim.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "npmignore --auto --commentLines=autogenerated",
		"prepublishOnly": "safe-publish-latest",
		"prepublish": "not-in-publish || npm run prepublishOnly",
		"prelint": "evalmd --eslint README.md",
		"lint": "eslint .",
		"postlint": "es-shim-api --type=method && tsc -p . && attw -P --ignore-rules named-exports",
		"pretest": "npm run --silent lint",
		"test": "npm run --silent tests-only",
		"tests-only": "nyc tape test/{implementation,index,requirePromise,PerformPromiseAllKeyed,shimmed}.js",
		"test:promise-shimmed": "node test/promise-shimmed.js",
		"posttest": "npx npm@'>= 10.2' audit --production",
		"version": "auto-changelog && git add CHANGELOG.md",
		"postversion": "auto-changelog && git add CHANGELOG.md && git commit --no-edit --amend && git tag -f \"v$(node -e \"console.log(require('./package.json').version)\")\"",
		"dependencies": "node -p \"process.env.npm_command\" | npx \"dt-clean@^1.2.2\" --auto"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/es-shims/Promise.allSettledKeyed.git"
	},
	"keywords": [
		"promise",
		"promises",
		"await",
		"dictionary",
		"keyed",
		"allSettledKeyed",
		"allSettled",
		"settled",
		"await dictionary",
		"shim",
		"polyfill",
		"es-shim API"
	],
	"dependencies": {
		"call-bind": "^1.0.9",
		"call-bound": "^1.0.4",
		"define-properties": "^1.2.1",
		"es-abstract": "^1.24.2",
		"es-errors": "^1.3.0",
		"own-keys": "^1.0.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@es-shims/api": "^4.0.0",
		"@ljharb/eslint-config": "^22.2.3",
		"@ljharb/tsconfig": "^0.3.2",
		"@types/call-bind": "^1.0.5",
		"@types/define-properties": "^1.1.5",
		"@types/es-abstract": "^1.24.1",
		"@types/es6-shim": "^0.31.46",
		"@types/functions-have-names": "^1.2.2",
		"@types/object-inspect": "^1.13.0",
		"auto-changelog": "^2.6.0",
		"es6-shim": "^0.35.8",
		"eslint": "^10.8.0",
		"evalmd": "^0.0.22",
		"for-each": "^0.3.5",
		"functions-have-names": "^1.2.3",
		"in-publish": "^2.0.1",
		"jiti": "^0.0.0",
		"npmignore": "^0.3.5",
		"nyc": "^10.3.2",
		"object-inspect": "^1.13.4",
		"safe-publish-latest": "^2.0.0",
		"tape": "^5.10.2",
		"typescript": "next"
	},
	"testling": {
		"files": "test/index.js"
	},
	"engines": {
		"node": ">= 0.4"
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"unreleased": false,
		"commitLimit": false,
		"backfillLimit": false,
		"hideCredit": true
	},
	"publishConfig": {
		"ignore": [
			".editorconfig",
			".github/workflows",
			".nycrc",
			"eslint.config.mjs",
			"test",
			"types"
		]
	}
}
